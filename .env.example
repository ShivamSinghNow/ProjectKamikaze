# Copy to .env and edit. docker-compose will read it automatically.
LOG_LEVEL=INFO

# Control plane
CONTROL_PLANE_PORT=8000

# Redis (sim dataplane + KAM-11 gossip mesh)
REDIS_URL=redis://redis:6379

# Sim service tick rate (KAM-8). Drones' TICK_HZ should match for stable hover.
SIM_TICK_HZ=30

# Per-drone control policy: noop | ppo | pronav
# KAM-5 ships with `noop` so compose stays green without a checkpoint.
# KAM-9 flips this to `ppo` once intercept_ppo.zip exists in ./models/.
POLICY=noop
PPO_CHECKPOINT=/models/intercept_ppo.zip

# Per-drone role (set per-service in compose, NOT here):
#   drone-1..4 = perimeter (90° outward-facing camera each)
#   drone-5    = spotter (elevated 5m, 360° pano in KAM-10)
